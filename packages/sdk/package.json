{
  "name": "@pidgeon-ai/sdk",
  "version": "2.11.1",
  "description": "Pidgeon's TypeScript SDK. Email inboxes for AI agents: give each agent its own address on @pidgeon.email or your domain, or white-label inboxes for every user of your platform. Plus Sign in with Pidgeon.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pidgeon-ai/pidgeon-js.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://pidgeon.ai",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./credential": {
      "types": "./dist/credential.d.ts",
      "default": "./dist/credential.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./verdict": {
      "types": "./dist/verdict.d.ts",
      "default": "./dist/verdict.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "http-message-sig": "0.3.0",
    "web-bot-auth": "0.2.0",
    "jose": "^6.2.17"
  },
  "keywords": [
    "email",
    "inbox",
    "ai-agents",
    "agent-email",
    "mcp",
    "multi-tenant",
    "white-label",
    "email-api",
    "oauth",
    "openid-connect"
  ],
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5"
  }
}
