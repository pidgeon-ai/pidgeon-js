{
  "name": "@pidgeon-ai/sdk",
  "version": "1.19.2",
  "description": "Email inboxes for AI agents — TypeScript SDK for Pidgeon: create addresses, send, receive and reply.",
  "keywords": [
    "email",
    "email-api",
    "inbox",
    "ai-agents",
    "agent",
    "llm",
    "mcp",
    "otp",
    "verification-code",
    "pidgeon",
    "webhooks",
    "api-client"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pidgeon-ai/pidgeon-js.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://pidgeon.ai",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "bugs": {
    "url": "https://github.com/pidgeon-ai/pidgeon-js/issues"
  }
}
