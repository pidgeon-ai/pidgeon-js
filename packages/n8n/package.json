{
  "name": "@pidgeon-ai/n8n-nodes-pidgeon",
  "version": "1.0.0",
  "description": "Pidgeon in n8n: inboxes for AI agents (send, reply, read and wait for mail, a trigger for mail that arrives) and verifying the agents that reach your site.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "pidgeon",
    "email",
    "inbox",
    "ai-agents",
    "agent-identity",
    "webhook"
  ],
  "license": "MIT",
  "author": {
    "name": "Pidgeon",
    "email": "support@pidgeon.ai"
  },
  "homepage": "https://pidgeon.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pidgeon-ai/pidgeon-js.git",
    "directory": "packages/n8n"
  },
  "bugs": {
    "url": "https://github.com/pidgeon-ai/pidgeon-js/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "n8n-node build",
    "lint": "n8n-node lint",
    "typecheck": "tsc --noEmit",
    "dev": "n8n-node dev"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/PidgeonApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Pidgeon/Pidgeon.node.js",
      "dist/nodes/PidgeonTrigger/PidgeonTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.57.3",
    "eslint": "9.39.4",
    "n8n-workflow": "2.47.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
