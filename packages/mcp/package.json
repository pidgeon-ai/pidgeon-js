{
  "name": "@pidgeon-ai/mcp",
  "version": "0.15.0",
  "mcpName": "ai.pidgeon/mcp",
  "description": "MCP server that gives your AI agent its own email inbox (Pidgeon).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "email",
    "email-api",
    "inbox",
    "ai-agents",
    "agent",
    "llm",
    "otp",
    "verification-code",
    "pidgeon"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pidgeon-ai/pidgeon-js.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://pidgeon.ai",
  "type": "module",
  "bin": {
    "pidgeon-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pidgeon-ai/sdk": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5",
    "@types/node": "^24"
  },
  "bugs": {
    "url": "https://github.com/pidgeon-ai/pidgeon-js/issues"
  }
}
