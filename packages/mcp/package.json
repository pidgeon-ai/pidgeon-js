{
  "name": "@pidgeon-ai/mcp",
  "version": "1.14.0",
  "description": "Pidgeon's MCP server. Email inboxes for AI agents: give each agent its own address on @pidgeon.email or your domain, or white-label inboxes for every user of your platform. Plus Sign in with Pidgeon.",
  "license": "Apache-2.0",
  "type": "module",
  "mcpName": "ai.pidgeon/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pidgeon-ai/pidgeon-js.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://pidgeon.ai",
  "keywords": [
    "email",
    "inbox",
    "ai-agents",
    "agent-email",
    "mcp",
    "multi-tenant",
    "white-label",
    "model-context-protocol",
    "pidgeon"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pidgeon-mcp": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pidgeon-ai/sdk": "workspace:^",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5"
  }
}
