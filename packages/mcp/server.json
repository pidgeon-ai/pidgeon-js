{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.pidgeon/mcp",
  "title": "Pidgeon",
  "description": "Verified identity, inboxes and sign-in for AI agents, and a way for websites to see who runs them.",
  "websiteUrl": "https://pidgeon.ai",
  "repository": {
    "url": "https://github.com/pidgeon-ai/pidgeon-js",
    "source": "github",
    "subfolder": "packages/mcp"
  },
  "version": "1.10.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@pidgeon-ai/mcp",
      "version": "1.10.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PIDGEON_API_KEY",
          "description": "An API key, instead of signing in with the browser.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://pidgeon.ai/mcp"
    }
  ]
}
