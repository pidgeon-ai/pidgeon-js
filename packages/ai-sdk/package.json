{
  "name": "@pidgeon-ai/ai-sdk",
  "version": "1.0.1",
  "description": "Email inboxes for AI agents, as Vercel AI SDK tools: send, wait for the reply and answer, on @pidgeon.email or your domain. The same tools as Pidgeon's MCP server.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pidgeon-ai/pidgeon-js.git",
    "directory": "packages/ai-sdk"
  },
  "homepage": "https://pidgeon.ai",
  "keywords": [
    "email",
    "inbox",
    "ai-agents",
    "agent-email",
    "mcp",
    "multi-tenant",
    "white-label",
    "vercel-ai-sdk",
    "ai-sdk",
    "tools",
    "pidgeon"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "ai": "^7"
  },
  "dependencies": {
    "@pidgeon-ai/mcp": "workspace:^",
    "@pidgeon-ai/sdk": "workspace:^",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "ai": "^7.0.173",
    "typescript": "^5"
  }
}
