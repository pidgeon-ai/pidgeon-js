{
  "name": "@pidgeon-ai/cli",
  "version": "1.23.0",
  "description": "Email inboxes for AI agents, from a terminal — the Pidgeon CLI: create addresses, send, receive and reply.",
  "keywords": [
    "email",
    "email-api",
    "inbox",
    "ai-agents",
    "agent",
    "llm",
    "mcp",
    "otp",
    "verification-code",
    "pidgeon",
    "cli",
    "api-client",
    "agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pidgeon-ai/pidgeon-js.git",
    "directory": "packages/cli"
  },
  "homepage": "https://pidgeon.ai",
  "type": "module",
  "bin": {
    "pidgeon": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./commands": {
      "import": {
        "types": "./dist/commands.gen.d.ts",
        "default": "./dist/commands.gen.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@pidgeon-ai/sdk": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "bugs": {
    "url": "https://github.com/pidgeon-ai/pidgeon-js/issues"
  }
}
