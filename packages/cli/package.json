{
  "name": "@pidgeon-ai/cli",
  "version": "2.5.1",
  "description": "Email inboxes for AI agents, from a terminal: make an inbox on @pidgeon.email or your domain, send, and wait for the reply. Pods for platforms, and Sign in with Pidgeon.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pidgeon-ai/pidgeon-js.git",
    "directory": "packages/cli"
  },
  "homepage": "https://pidgeon.ai",
  "keywords": [
    "email",
    "inbox",
    "ai-agents",
    "agent-email",
    "mcp",
    "multi-tenant",
    "white-label",
    "cli",
    "pidgeon"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pidgeon": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@pidgeon-ai/sdk": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5"
  }
}
