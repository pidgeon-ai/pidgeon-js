{
  "name": "@pidgeon-ai/id",
  "version": "0.1.1",
  "description": "A free, signed identity for your AI agents on your own domain, in one command — and the open library they sign email, HTTP requests and MCP calls with.",
  "keywords": [
    "agent-identity",
    "ai-agents",
    "web-bot-auth",
    "http-message-signatures",
    "rfc9421",
    "ed25519",
    "email",
    "mcp",
    "pidgeon",
    "post"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pidgeon-ai/pidgeon-js.git",
    "directory": "packages/id"
  },
  "homepage": "https://pidgeon.ai",
  "type": "module",
  "bin": {
    "pidgeon-id": "dist/bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "bugs": {
    "url": "https://github.com/pidgeon-ai/pidgeon-js/issues"
  }
}
